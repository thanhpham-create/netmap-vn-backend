{
  "name": "netmap-vn-backend",
  "version": "1.0.0",
  "description": "NetMap VN - 5G Coverage Map & Outage Detection",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "db:reset": "tsx src/db/reset.ts",
    "db:setup": "tsx src/db/reset.ts && tsx src/db/migrate.ts",
    "db:seed": "tsx scripts/seed-demo.ts",
    "db:bench": "tsx scripts/bench-coverage.ts",
    "db:init": "echo '⚠️  db:init is deprecated. Use db:migrate (safe, idempotent) or db:setup (destructive, dev only).' && exit 1",
    "test": "tsc -p tsconfig.tests.json && node scripts/run-tests.mjs",
    "test:tsx": "NODE_OPTIONS='--import tsx' node --test --test-reporter=tap --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^9.0.1",
    "@fastify/rate-limit": "^10.1.1",
    "@sentry/node": "^8.40.0",
    "fastify": "^5.1.0",
    "postgres": "^3.4.5",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "yarn@4.14.1"
}
