# NetMap VN backend — env vars

# ============ REQUIRED ============
# PostgreSQL connection. On Railway use ${{Postgres.DATABASE_URL}} reference.
DATABASE_URL=postgresql://user:pass@host:5432/netmap

# JWT signing secret. REQUIRED in production. Generate via: openssl rand -hex 64
JWT_SECRET=change-this-to-a-long-random-string

# ============ OPTIONAL ============
# Listen port (default 8080). Railway injects this automatically.
PORT=8080

# Log level: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Comma-separated list of allowed origins. If unset in non-production, all origins allowed.
# Production example: CORS_ORIGINS=https://netmap-vn.vercel.app,https://netmap.vn
CORS_ORIGINS=

# Set to 'production' on prod. This causes JWT_SECRET to be required and devOtp not exposed.
NODE_ENV=production

# ============ SMS PROVIDER ============
# Default 'console' (only logs OTP, does NOT send SMS) — fine for dev/test.
# For production set 'esms' and configure ESMS_* vars below.
SMS_PROVIDER=console

# eSMS.vn brandname API. Đăng ký tại https://esms.vn
# Brandname phải được duyệt trước (1-2 ngày làm việc) — gửi mẫu nội dung OTP.
ESMS_API_KEY=
ESMS_SECRET_KEY=
ESMS_BRANDNAME=

# Set true để dùng SmsType=8 (test mode, không gửi SMS thật, không tính phí).
# Chuyển sang false khi production-ready.
ESMS_TEST_MODE=true

# ============ WEB PUSH (VAPID) ============
# Generate keys 1 lần: npx web-push generate-vapid-keys
# Public key cần expose cho frontend qua endpoint /api/v1/push/vapid-public-key
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@netmap.vn

# ============ ERROR MONITORING (Sentry) ============
# Tạo project tại https://sentry.io → Settings → Client Keys → DSN
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
